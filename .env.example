# Development defaults used by `docker compose -f compose.yaml -f compose.dev.yaml up --build`.
# Copy this file to `.env` only for local development. Do not use these values in production.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_dev
POSTGRES_DB=ecommerce

# CORS
CORS_ORIGINS=http://localhost:3001
CORS_CREDENTIALS=true

# Production configuration is supplied from an untracked environment file, for example:
# docker compose --env-file /etc/ecommerce/production.env -f compose.yaml -f compose.prod.yaml up -d --build
#
# Required production variables:
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="E-commerce <no-reply@example.com>"
# CORS_ORIGINS=https://shop.example.com
# CORS_CREDENTIALS=true
#
# Optional production variables:
# SMTP_PORT=587
# SMTP_SECURE=false
# MAIL_SMTP_TIMEOUT_MS=10000
# MAIL_OUTBOX_BATCH_SIZE=20
# MAIL_PROCESSING_TIMEOUT_SECONDS=120
