# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecommerce
DB_PASSWORD=ecommerce_dev
DB_NAME=ecommerce

# Set to true only for managed environments such as the Docker Compose stack.
TYPEORM_MIGRATIONS_RUN=false

# Mailpit (development, when the API runs directly on the host)
MAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="E-commerce <no-reply@ecommerce.test>"

# SMTP real (set MAIL_PROVIDER=smtp and fill every required value)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Worker limits
MAIL_SMTP_TIMEOUT_MS=10000
MAIL_OUTBOX_BATCH_SIZE=20
MAIL_PROCESSING_TIMEOUT_SECONDS=120
